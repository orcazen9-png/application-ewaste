# Copy to .env locally. Never put credentials in dist/ or a browser input.
GEMINI_API_KEY=
# Set an image-understanding model supporting JSON schema that your account can access.
GEMINI_MODEL=
# Operations settings belong to the separate account staging Worker.
# Keep disabled until its Cloudflare Access application and staff invitations are configured.
OPS_ENABLED=false
OPS_ACCESS_ISSUER=
OPS_ACCESS_AUD=
